# JPM OAuth Configuration
# Copy to .env and fill in your values

JPM_OAUTH_URL=https://api-sandbox.payments.jpmorgan.com/oauth
JPM_CLIENT_ID=your_client_id_here
JPM_CLIENT_SECRET=your_client_secret_here
JPM_SCOPE=payments
JPM_GRANT_TYPE=client_credentials
JPM_API_BASE_URL=https://api-sandbox.payments.jpmorgan.com

# Stripe Connect (use a test-mode restricted API key; never commit real values)
STRIPE_API_KEY=__SET_TEST_RESTRICTED_KEY__
STRIPE_WEBHOOK_SECRET=__SET_TEST_WEBHOOK_SIGNING_SECRET__
DATABASE_URL=postgres://user:password@localhost:5432/equity_shield

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000
ENABLE_VERBOSE_ERRORS=true
INTERNAL_API_KEY=__SET_STRONG_RANDOM_SECRET__
